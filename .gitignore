# Ignore all files and folders in root by default
/*
!.gitignore
!/frontend/

# Ignore frontend build & dependency files
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/*.tsbuildinfo
frontend/*.log

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
